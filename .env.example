NODE_ENV=development
PORT=3000
SONIMIX_DATA_DIR=./data
MAX_UPLOAD_MB=200

# Configure the audio toolchain on the server. Jobs fail clearly if binaries are missing.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
DEMUCS_BIN=demucs
DEMUCS_MODEL=htdemucs

# First administrator is created from these credentials during server startup.
# Use a unique password of at least 14 characters; never commit a real .env file.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-14-characters

# Optional server-only integrations.
XAI_API_KEY=
XAI_MODEL=
ELEVENLABS_API_KEY=
MUSICGPT_API_KEY=

# Loudly is disabled until account-specific API documentation and access are available.
