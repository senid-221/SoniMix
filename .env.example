# Required before the API accepts uploads, jobs, or generated files.
SONIMIX_API_TOKEN="replace-with-a-long-random-token"

# Use absolute paths in deployments. The local default is ./data.
SONIMIX_DATA_DIR="./data"
FFMPEG_BIN="ffmpeg"
FFPROBE_BIN="ffprobe"
DEMUCS_BIN="demucs"
DEMUCS_MODEL="htdemucs"

# Enable only providers supported by the account.
XAI_API_KEY=""
XAI_MODEL=""
ELEVENLABS_API_KEY=""

# Loudly is intentionally disabled until an account-specific official API contract is configured.
